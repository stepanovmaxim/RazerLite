#include <windows.h>

101 ICON "icon.ico"

1 VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "RazerLite - tray control for Razer mice"
            VALUE "FileVersion",     "1.0.0.0"
            VALUE "InternalName",    "RazerLite"
            VALUE "OriginalFilename","RazerLite.exe"
            VALUE "ProductName",     "RazerLite"
            VALUE "ProductVersion",  "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
